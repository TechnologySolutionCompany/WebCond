# =============================================
# WebCond – Variáveis de Ambiente
# =============================================
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para .env
# 2. Preencha as variáveis com suas credenciais
# 3. Salve e reinicie o dev server (npm run dev)

# =============================================
# MODO DEMO (Padrão - Sem Supabase)
# =============================================
# Deixe as linhas abaixo comentadas para usar modo DEMO com dados locais
# (não precisa de Supabase, tudo roda localmente)

# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# =============================================
# SUPABASE REAL (Se quiser conectar ao Supabase)
# =============================================
# Descomente e preencha com suas credenciais do Supabase
# OBTÉM-SE EM: Supabase Dashboard → Settings → API

# URL do seu projeto Supabase (ex: https://xxxxxxxxxxx.supabase.co)
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (começa com eyJhbGc...)
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================
# FORÇAR MODO DEMO (Opcional)
# =============================================
# Defina como 'true' para forçar modo demo, mesmo com credenciais preenchidas
# VITE_FORCE_DEMO_MODE=false
