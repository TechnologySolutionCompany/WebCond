# Copie para .env e preencha com os valores de Supabase > Settings > API.
# Sem aspas e sem espacos ao redor do "=".

# ------------------------------------------------------------------
# FRONTEND (publico - vai para o bundle do navegador)
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx
# Opcional: link de pagamento/renovacao exibido no aviso "Atualize seu plano" (vazio = botao oculto).
VITE_PLAN_UPGRADE_URL=

# ------------------------------------------------------------------
# BACKEND (funcoes em /api e scripts em /scripts)
# ------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxx

# CRITICO: acesso total ao banco, ignora RLS. Nunca commitar, nunca prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_apenas_no_backend

# ------------------------------------------------------------------
# OPCIONAL - nomes alternativos aceitos pelo backend
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxx

# Somente local, para npm run security-test (login do admin da plataforma). Nunca na Vercel.
PLATFORM_ADMIN_DOCUMENT=
PLATFORM_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# NOTIFICACOES (v1.09A3)
# ------------------------------------------------------------------
# Celular/computador (Web Push). Gere com: npx web-push generate-vapid-keys
# A publica vai para o navegador; a privada so no backend (nunca com prefixo VITE_).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://webcond.vercel.app
# Endereco usado nos links dos e-mails.
APP_URL=https://webcond.vercel.app

# E-mail (Resend). Vazio = canal desligado. O remetente precisa ser de um dominio verificado no Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# WhatsApp oficial (Meta Cloud API). Vazio = canal desligado. O modelo precisa estar aprovado na Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=webcond_notificacao
WHATSAPP_TEMPLATE_LANG=pt_BR

# ------------------------------------------------------------------
# ASSINATURA / PAGAMENTO (espaco reservado - v1.10)
# ------------------------------------------------------------------
# Enquanto vazio, contratar plano continua sendo pelo WhatsApp da TSCBr.
# Provedor: mercadopago | asaas | pagarme | stripe (veja src/lib/assinatura.js).
VITE_ASSINATURA_PROVEDOR=
# Endereco https do checkout. So com provedor E endereco o botao "Quero o plano X" muda.
VITE_ASSINATURA_CHECKOUT_URL=
# Segredo que assina o webhook do provedor. Backend apenas, nunca com prefixo VITE_.
ASSINATURA_WEBHOOK_SECRET=
